# /etc/t3ctl.conf — the one box-specific file for the t3ctl tooling.
# Shell KEY=VALUE lines; sourced by t3ctl, t3-token-renew and the
# t3-callback-approver unit, parsed by t3-notify. install.sh copies this
# file into place once and never overwrites it.

# Where t3 serves and who runs it (token minting happens as this user, in
# this directory, with the version pinned in this file).
T3CTL_URL=http://127.0.0.1:3773
T3CTL_T3_USER=dev
T3CTL_T3_WORKDIR=/data/workspace
T3CTL_T3_VERSION_FILE=/etc/default/t3
T3CTL_DB=/data/home/dev/.t3/userdata/statev2.sqlite   # t3's V2 db; t3-events `managed`/contract-check read it (read-only)

# Credentials written by t3-token-renew (root-only), both least-privilege.
# Since v0.6.0 there are two: T3's MCP endpoint accepts only `mcp-client`
# sessions, and every other path rejects them.
# 1. The legacy-path session (approvals, the callback approver, stop, rm,
#    list --all, say --mode/--plan/--execute, project add/set-model):
T3CTL_TOKEN_FILE=/etc/t3ctl/token
T3CTL_SESSION_FILE=/etc/t3ctl/session-id
T3CTL_TOKEN_TTL=30d
T3CTL_TOKEN_LABEL=t3ctl
#T3CTL_TOKEN_SCOPES="orchestration:read orchestration:operate"   # its scopes (default)
# 2. The MCP credential (everything else). Defaults derive from the keys
#    above, so an existing conf needs no new lines:
#T3CTL_MCP_TOKEN_FILE=/etc/t3ctl/token.mcp          # default: $T3CTL_TOKEN_FILE.mcp
#T3CTL_MCP_SESSION_FILE=/etc/t3ctl/session-id.mcp   # default: $T3CTL_SESSION_FILE.mcp
#T3CTL_MCP_TOKEN_LABEL=t3ctl-mcp                    # default: $T3CTL_TOKEN_LABEL-mcp
#T3CTL_MCP_ACCESS=full-access   # runtime-mode ceiling T3 enforces on it: the broadest
#                               # mode t3ctl may start/message/settle a thread in.
#                               # Default full-access when T3CTL_ALLOW_FULL_ACCESS=1,
#                               # else auto; full-access is refused when that is 0.
#                               # Minted with a one-time pairing code (OAuth approval):
#                               # a CLI-issued mcp-client session is capped at
#                               # approval-required. TTL is T3's fixed 30 d.
#T3CTL_WATCH_SLICE=15           # watch blocks server-side in slices of this many seconds,
#                               # re-checking for pending approvals/questions between them

# Threads the agent creates are titled with this prefix; stop/interrupt/rm
# refuse other threads without --force, and the callback approver only acts
# inside these threads.
T3CTL_TAG="[agent]"
T3CTL_MAX_RUNNING=3

# How a session calls the agent back. The binary name appears in the prompt
# footer and in the approver's match rule; a symlink with this name is
# created if it differs from t3-notify.
T3CTL_NOTIFY_BIN=t3-notify
T3_NOTIFY_URL=http://127.0.0.1:8644/webhooks/t3-callback
T3_NOTIFY_SECRET_FILE=/etc/t3ctl/notify.secret

# Alerts when token rotation fails (hermes send targets; empty = no alert).
T3CTL_HERMES=/opt/hermes-venv/bin/hermes
T3CTL_HERMES_HOME=/data/repo/home
T3CTL_ALERT_TARGET=
T3CTL_ALERT_FALLBACK=

# --- Container mode (Kosmi-style: t3ctl runs as the same user and T3CODE_HOME
# as the t3 server, no systemd). Leave unset on a devbox.
#T3CTL_TOKEN_MODE=self          # mint/rotate the bearer session in-process (default: file)
#T3CTL_T3_BIN=t3                # the t3 CLI used for minting in self mode
#T3CODE_HOME=/data/t3           # its data dir (T3CTL_T3_HOME is an alias)
#T3CTL_ALLOW_FULL_ACCESS=0      # 0 refuses --full-access outright (default 1)
#T3CTL_DEFAULT_MODE=full-access # mode `new` starts threads in (default approval-required; full-access needs ALLOW=1)
#T3CTL_DENY_ORIGINS=webhook:auto-demo   # Hermes session origins that may never reach t3
#T3CTL_EVENTS_ORIGINS=webhook:linear-comment:thread-   # webhook chat ids whose persistent sessions take T3 events

# --- Session state events (t3-events). Every registration decision is logged
# beside the events DB; a manual fallback names its reason (monitoringReason).
#T3CTL_EVENTS_DB=$T3CODE_HOME/t3ctl-events.sqlite
#T3CTL_EVENTS_LOG=$T3CODE_HOME/t3ctl-events.log     # default: next to the events DB
#T3CTL_EVENTS_LOG_MAX=1000000                       # bytes; one rotation (.log.1)
