#!/usr/bin/env bash
# t3ctl — drive T3 Code sessions from an agent (Hermes). JSON out.
#
# Since v0.6.0 t3ctl speaks T3's orchestration MCP endpoint (POST /mcp, the
# server T3's own agents use; bin/t3-mcp) for everything MCP covers: projects,
# models, list, search, show, last, new, say, watch, answer, settle/unsettle,
# interrupt. What MCP cannot do (approvals, the callback approver, stop, rm,
# list --all, mode changes on say, project add/set-model) stays on the app's
# private API, isolated in bin/t3ctl-legacy.sh. MCP results are normalised
# below into the turn/approval shape t3ctl's output has always had.
#
# Configuration: /etc/t3ctl.conf (see t3ctl.conf.example; override the path
# with T3CTL_CONF); every T3CTL_* below can also come from the environment.
#
# Two credentials, because /mcp only accepts `mcp-client` sessions and every
# other path rejects them:
#   T3CTL_MCP_TOKEN_FILE  an mcp-client session with orchestration:read +
#        orchestration:operate and a runtime-mode ceiling (T3CTL_MCP_ACCESS).
#        A ceiling is only granted through T3's OAuth approval, so it is
#        minted with a one-time pairing code (a CLI-issued mcp-client session
#        is capped at approval-required: it could not drive a full-access thread).
#   T3CTL_TOKEN_FILE      an ordinary session with T3CTL_TOKEN_SCOPES only
#        (orchestration:read + orchestration:operate) for the legacy calls.
# Two token modes, for both:
#   file (default, devbox): t3-token-renew (weekly timer) mints as the t3 user
#        and writes the tokens root-only; t3ctl re-reads them per invocation.
#   self (containers): t3ctl runs as the same user and T3CODE_HOME as the t3
#        server and mints/rotates its own sessions on first use and on 401.
#
# If commands break after a T3_VERSION bump, run `t3ctl contract-check`, then
# see docs/COMPAT.md.
#
# Guardrails (deliberate, do not quietly remove — MCP enforces none of them):
#   - new starts turns in T3CTL_DEFAULT_MODE (approval-required unless the
#     deployment says otherwise), say inherits the thread's mode, and
#     --full-access / a full-access default only exist when
#     T3CTL_ALLOW_FULL_ACCESS=1 (default).
#   - new refuses while >= T3CTL_MAX_RUNNING tagged turns are already running.
#   - stop/interrupt/rm refuse threads not titled "$T3CTL_TAG …" without
#     --force (those are the owner's own sessions, not ours to kill).
#   - T3CTL_DENY_ORIGINS refuses every command from listed Hermes session
#     origins (unattended webhook lanes), see origin_gate below.
#   - say --expect-turn refuses once the thread moved past the turn read.
set -uo pipefail

# shellcheck disable=SC1090
T3CTL_CONF=${T3CTL_CONF:-/etc/t3ctl.conf}
[ -r "$T3CTL_CONF" ] && . "$T3CTL_CONF"
BASE=${T3CTL_URL:-http://127.0.0.1:3773}
T3_HOME=${T3CODE_HOME:-${T3CTL_T3_HOME:-/data/t3}}
T3_BIN=${T3CTL_T3_BIN:-t3}
TOKEN_MODE=${T3CTL_TOKEN_MODE:-file}
TOKEN_FILE=${T3CTL_TOKEN_FILE:-/etc/t3ctl/token}
SESSION_FILE=${T3CTL_SESSION_FILE:-/etc/t3ctl/session-id}
TOKEN_TTL=${T3CTL_TOKEN_TTL:-30d}
TOKEN_LABEL=${T3CTL_TOKEN_LABEL:-t3ctl}
TOKEN_SCOPES=${T3CTL_TOKEN_SCOPES:-orchestration:read orchestration:operate}   # the legacy-path token
MCP_TOKEN_FILE=${T3CTL_MCP_TOKEN_FILE:-$TOKEN_FILE.mcp}
MCP_SESSION_FILE=${T3CTL_MCP_SESSION_FILE:-$SESSION_FILE.mcp}
MCP_LABEL=${T3CTL_MCP_TOKEN_LABEL:-$TOKEN_LABEL-mcp}
DB=${T3CTL_DB:-/data/home/dev/.t3/userdata/statev2.sqlite}
MAX_RUNNING=${T3CTL_MAX_RUNNING:-3}
TAG=${T3CTL_TAG:-[agent]}
NOTIFY_CMD=${T3CTL_NOTIFY_BIN:-${T3CTL_NOTIFY_CMD:-t3-notify}}   # the callback command sessions run
NOTIFY_BIN=$NOTIFY_CMD   # same thing; selftest and the approver use this name
ALLOW_FULL=${T3CTL_ALLOW_FULL_ACCESS:-1}
DEFAULT_MODE=${T3CTL_DEFAULT_MODE:-approval-required}   # mode `new` starts threads in
MODE_FIXED=${T3CTL_DEFAULT_MODE:+1}   # set explicitly by the deployment → `new --mode` may not override it
case $DEFAULT_MODE in
  approval-required|auto-accept-edits|auto) ;;
  full-access) [ "$ALLOW_FULL" = 1 ] || { echo "t3ctl: T3CTL_DEFAULT_MODE=full-access ignored (T3CTL_ALLOW_FULL_ACCESS=$ALLOW_FULL); using approval-required" >&2; DEFAULT_MODE=approval-required; };;
  *) echo "t3ctl: invalid T3CTL_DEFAULT_MODE '$DEFAULT_MODE'; using approval-required" >&2; DEFAULT_MODE=approval-required;;
esac
# The MCP credential's runtime-mode ceiling: T3 refuses to start, message or
# settle a thread in a broader mode. Default: the broadest mode this
# deployment's policy lets t3ctl use.
if [ "$ALLOW_FULL" = 1 ]; then MCP_ACCESS=${T3CTL_MCP_ACCESS:-full-access}; else MCP_ACCESS=${T3CTL_MCP_ACCESS:-auto}; fi
case $MCP_ACCESS in
  approval-required|auto-accept-edits|auto) ;;
  full-access) [ "$ALLOW_FULL" = 1 ] || { echo "t3ctl: T3CTL_MCP_ACCESS=full-access ignored (T3CTL_ALLOW_FULL_ACCESS=$ALLOW_FULL); using auto" >&2; MCP_ACCESS=auto; };;
  *) echo "t3ctl: invalid T3CTL_MCP_ACCESS '$MCP_ACCESS'; using approval-required" >&2; MCP_ACCESS=approval-required;;
esac
DENY_ORIGINS=${T3CTL_DENY_ORIGINS:-}
# Chars of message text shown per message (0 = no limit). The cap is for a
# human at a terminal; an agent reading the output wants the whole reply
# (Cactus was adding T3CTL_TEXT_CAP=50000 to most calls by hand).
if [ -t 1 ]; then TEXT_CAP=${T3CTL_TEXT_CAP:-3000}; else TEXT_CAP=${T3CTL_TEXT_CAP:-0}; fi
[[ $TEXT_CAP =~ ^[0-9]+$ ]] || TEXT_CAP=3000
# watch blocks server-side (t3_thread_wait) in slices of this many seconds;
# between slices it checks for pending approvals/questions, which do not end a wait.
WATCH_SLICE=${T3CTL_WATCH_SLICE:-15}
[[ $WATCH_SLICE =~ ^[1-9][0-9]*$ ]] || WATCH_SLICE=15
ACTIVE_STATUSES=preparing,queued,starting,running,waiting
HERE=$(dirname "${BASH_SOURCE[0]}")
T3MCP=$HERE/t3-mcp

die() { echo "t3ctl: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
t3ctl — drive T3 Code sessions (JSON/JSONL output)

  t3ctl projects                          projects (id, title, workspaceRoot)
  t3ctl models                            model selections usable with --model
  t3ctl list [--unarchived|--active|--all] threads (JSONL). Default = the app's
                                          inbox (unsettled, unarchived; --unsettled
                                          is an alias); --unarchived every
                                          non-archived thread, settled too;
                                          --active only running/attention;
                                          --all everything, archived included
  t3ctl new <project> "<prompt>" [opts]   create thread + start first turn
        [--title T] [--plan | --execute] [--prompt-file path|-] [--model M] [--mode M | --full-access]
        [--dispatch-id ID]
  t3ctl say <thread> "<text>" [opts]      start a turn on an existing thread
        [--expect-turn ID] [--plan | --execute] [--prompt-file path|-] [--model M] [--mode M | --full-access | --inherit]
        [--dispatch-id ID]
                                          --expect-turn: refuse unless the thread's latest
                                          turn is still ID (the one you read; "none" for
                                          a thread without turns) — stops duplicate sends
                                          --dispatch-id: reuse a receipt's dispatchId to
                                          retry a new/say whose receipt was lost; T3
                                          returns the same thread/message, no new work
  t3ctl show <thread> [-n TURNS]          messages, turn state, approvals
  t3ctl last <thread> [--json]            the latest assistant reply, in full, as plain
                                          text (--json: {threadId,turnId,turn,text})
  t3ctl search "<text>" [--limit N]       find threads by title or message
                                          content (case-insensitive)
  t3ctl watch <thread> [--message-id ID] [--timeout S] [--after-turn ID]
                                          wait (server-side) until the turn settles or
                                          needs attention; prints outcome
  t3ctl answer <thread> <requestId> --answers-file path|-
                                          answer a pending question (JSON object)
  t3ctl settle <thread>                   mark done (leave the app's inbox)
  t3ctl unsettle <thread>                 put back into the app's inbox
  t3ctl approvals <thread>                pending/answered approval requests
  t3ctl approve <thread> <requestId> [decision]
                                          decision: accept (default) |
                                          acceptForSession | acceptAlways |
                                          decline | cancel
  t3ctl approve-callbacks [--loop S] [--dry-run]
                                          auto-accept pending approvals that are
                                          exactly a $T3CTL_NOTIFY_CMD callback, in
                                          threads tagged $T3CTL_TAG only
  t3ctl project add <path> [--title T]    register a workspace as a project
  t3ctl project set-model <project> <instanceId>:<model>
                                          set the project's default model
  t3ctl token [status|renew]              show / rotate both credentials (MCP + legacy)
                                          (renew needs T3CTL_TOKEN_MODE=self;
                                          file mode rotates via t3-token-renew)
  t3ctl selftest [--project P]            end-to-end probe: new → PONG, forced
                                          callback → auto-approved → settled,
                                          then rm; JSON verdict, exit 1 on fail
  t3ctl contract-check                    read-only probe of every MCP tool and
                                          legacy API contract this build depends on
  t3ctl interrupt <thread> [--force]      interrupt the running turn
  t3ctl stop <thread> [--force]           stop the provider session
  t3ctl rm <thread> [--force]             delete the thread

Message text is capped at T3CTL_TEXT_CAP chars (default 3000 on a terminal,
unlimited when piped; 0 = unlimited).
<thread> and <project> accept a full id, a unique id prefix, or (projects)
an exact title / workspaceRoot basename. Modes: approval-required,
auto-accept-edits, auto, full-access. --model takes a model name or
instance id from `t3ctl models` (e.g. codex, claude-opus-5), or a literal
instanceId:model pair (claudeAgent:claude-opus-5-5) on a fresh server;
without it the project default is used. Tag = T3CTL_TAG.
EOF
  exit 0
}

for c in curl jq uuidgen flock python3; do command -v "$c" >/dev/null || die "missing dependency: $c"; done

# Origin gate. Hermes bridges the calling session's identity into every
# command's env (gateway/session_context.py _VAR_MAP: HERMES_SESSION_PLATFORM,
# HERMES_SESSION_CHAT_ID = "webhook:<route>:<delivery>", HERMES_SESSION_CHAT_NAME
# = "webhook/<route>"). Unattended, externally triggered lanes (a webhook
# route running with session yolo) must never reach t3 — not even to read.
# T3CTL_DENY_ORIGINS is a comma-separated list of prefixes matched against
# the chat id and the chat name (e.g. "webhook:auto-demo"). Empty = no gate.
# Interactive shells (no session vars) and the approver loop are not gated.
origin_gate() {
  local plat=${HERMES_SESSION_PLATFORM:-} cid=${HERMES_SESSION_CHAT_ID:-} name=${HERMES_SESSION_CHAT_NAME:-} rule
  [ -n "$plat" ] || [ -n "$cid" ] || [ -n "$name" ] || return 0
  local IFS=,
  for rule in $DENY_ORIGINS; do
    [ -n "$rule" ] || continue
    case "$cid" in "$rule"*) die "refused: t3ctl is not available from this lane ($plat $cid) — coding threads are only started from conversations with people";; esac
    case "$name" in "$rule"*) die "refused: t3ctl is not available from this lane ($plat $name) — coding threads are only started from conversations with people";; esac
  done
}
origin_gate

# num FLAG VALUE — numeric flags must error on non-numeric input, not fail
# later inside arithmetic, sqlite or sleep with a misleading message.
num() { [[ ${2:-} =~ ^[0-9]+$ ]] || die "$1 expects a non-negative integer, got '${2:-}'"; }
now() { date -u +%Y-%m-%dT%H:%M:%S.%3NZ; }
uuid() { uuidgen | tr 'A-Z' 'a-z'; }

# ---- credentials -----------------------------------------------------------

t3cli() { # the t3 CLI as the server's user; </dev/null: it blocks on an open non-tty stdin (2026-09-08)
  T3CODE_HOME="$T3_HOME" "$T3_BIN" "$@" </dev/null
}
scope_flags() { local s; for s in $1; do printf -- '--scope %s ' "$s"; done; }

probe_token() { # $1 rpc|mcp, $2 token → 0 when it works on its own path
  if [ "$1" = mcp ]; then
    T3CTL_URL="$BASE" T3CTL_MCP_BEARER="$2" "$T3MCP" probe --t3ctl >/dev/null 2>&1
  else
    curl -sf -m 15 -H @<(printf 'Authorization: Bearer %s\n' "$2") -H "x-t3-orchestration-protocol: 2" "$BASE/api/orchestration/shell" -o /dev/null
  fi
}

# Self-service tokens: in T3CTL_TOKEN_MODE=self t3ctl runs as the same user and
# T3CODE_HOME as the t3 server (the Kosmi container), so it mints its own
# sessions, probes each on its own path before installing it, and revokes the
# predecessor. $1 = rpc|mcp, $2 = the token that just failed (empty when there
# was none). Serialised with flock per credential: concurrent t3ctl calls (the
# approver loop + the agent) can hit a 401 together, and two unsynchronised
# rotations would interleave the token/session files and revoke the wrong session.
mint_token() {
  local kind=$1 failed=${2:-} file sfile
  if [ "$kind" = mcp ]; then file=$MCP_TOKEN_FILE; sfile=$MCP_SESSION_FILE; else file=$TOKEN_FILE; sfile=$SESSION_FILE; fi
  mkdir -p "$(dirname "$file")" "$(dirname "$sfile")"
  (
    flock -w 60 9 || { echo "t3ctl: could not lock $file.lock" >&2; exit 1; }
    # Someone else may have rotated while we waited for the lock.
    if [ -s "$file" ]; then
      cur=$(tr -d ' \t\n' < "$file")
      if [ -n "$cur" ] && [ "$cur" != "$failed" ] && probe_token "$kind" "$cur"; then
        echo "t3ctl: $kind token already rotated by another process" >&2
        exit 0
      fi
    fi
    if [ "$kind" = rpc ]; then
      # shellcheck disable=SC2046
      out=$(t3cli auth session issue $(scope_flags "$TOKEN_SCOPES") --ttl "$TOKEN_TTL" --label "$TOKEN_LABEL" --json 2>&1) \
        || { echo "t3ctl: '$T3_BIN auth session issue' failed: $(tail -c 300 <<<"$out")" >&2; exit 1; }
      tok=$(jq -r '.token // empty' <<<"$out" 2>/dev/null); sid=$(jq -r '.sessionId // empty' <<<"$out" 2>/dev/null)
      [ -n "$tok" ] && [ -n "$sid" ] || { echo "t3ctl: could not parse token/sessionId from 'auth session issue' output" >&2; exit 1; }
    else
      # OAuth sign-in approved by a one-time pairing code that carries exactly
      # the scopes T3 grants at this access level (t3-mcp scopes).
      # shellcheck disable=SC2046
      pair=$(t3cli auth pairing create $(scope_flags "$("$T3MCP" scopes "$MCP_ACCESS")") --ttl 10m --label "$MCP_LABEL-pairing" --json 2>&1) \
        || { echo "t3ctl: '$T3_BIN auth pairing create' failed: $(tail -c 300 <<<"$pair" | grep -v credential)" >&2; exit 1; }
      code=$(jq -r '.credential // empty' <<<"$pair" 2>/dev/null); pair_id=$(jq -r '.id // empty' <<<"$pair" 2>/dev/null)
      [ -n "$code" ] || { echo "t3ctl: could not parse the pairing code from 'auth pairing create' output" >&2; exit 1; }
      name="$MCP_LABEL $(date -u +%Y%m%dT%H%M%SZ)-$(uuid | cut -c1-8)"   # unique: finds the session id below
      res=$(printf '%s' "$code" | T3CTL_URL="$BASE" "$T3MCP" oauth-mint --access "$MCP_ACCESS" --client-name "$name" 2>&1) || {
        [ -z "$pair_id" ] || t3cli auth pairing revoke "$pair_id" >/dev/null 2>&1
        echo "t3ctl: MCP sign-in failed: $(tail -c 300 <<<"$res")" >&2; exit 1; }
      tok=$(jq -r '.token // empty' <<<"$res" 2>/dev/null)
      [ -n "$tok" ] || { echo "t3ctl: MCP sign-in returned no token" >&2; exit 1; }
      sid=$(t3cli auth session list --json 2>/dev/null | jq -r --arg n "$name" \
        '[.[] | select(.client.label == $n) | .sessionId] | if length == 1 then .[0] else empty end' 2>/dev/null)
      [ -n "$sid" ] || echo "t3ctl: warning: could not find the new MCP session's id; it cannot be revoked at the next rotation and expires by its 30 d TTL" >&2
    fi
    probe_token "$kind" "$tok" \
      || { echo "t3ctl: freshly minted $kind token failed its probe against $BASE (t3 down, or the API changed after a t3 bump — run t3ctl contract-check)" >&2; exit 1; }
    old_sid=$(cat "$sfile" 2>/dev/null || true)
    umask 077
    printf '%s\n' "$tok" > "$file.tmp" && mv "$file.tmp" "$file" || exit 1
    printf '%s\n' "$sid" > "$sfile.tmp" && mv "$sfile.tmp" "$sfile" || exit 1
    if [ -n "$old_sid" ] && [ "$old_sid" != "$sid" ]; then
      t3cli auth session revoke "$old_sid" >/dev/null 2>&1 \
        || echo "t3ctl: warning: could not revoke previous $kind session $old_sid (it expires by TTL)" >&2
    fi
    echo "t3ctl: minted $kind session ${sid:-?} -> $file" >&2
  ) 9>"$file.lock"
}

mcp_token() {
  if [ -n "${MCP_PINNED:-}" ]; then printf '%s' "$MCP_PINNED"; return 0; fi
  if [ ! -s "$MCP_TOKEN_FILE" ]; then
    [ "$TOKEN_MODE" = self ] || die "cannot read $MCP_TOKEN_FILE (the MCP credential, root only; mint both with: systemctl start t3-token-renew)"
    mint_token mcp "" || die "could not mint the MCP credential"
  fi
  tr -d ' \t\n' < "$MCP_TOKEN_FILE"
}

# shellcheck source=t3ctl-legacy.sh
. "$HERE/t3ctl-legacy.sh"

# ---- MCP transport ---------------------------------------------------------

# mcp_raw T3MCP-ARGS… → MCP_OUT, MCP_ERR, MCP_RC (not in a subshell, so callers
# can branch on T3's typed failure code). The bearer travels in the
# environment, never in argv. A 401 in self mode re-mints once and retries;
# a refused credential never reached a handler, so the retry is safe.
mcp_raw() {
  local tok errf inf="" attempt
  tok=$(mcp_token) || exit 1
  errf=$(mktemp)
  if printf '%s\n' "$@" | grep -qx -- -; then inf=$(mktemp); cat > "$inf"; fi
  for attempt in 1 2; do
    if [ -n "$inf" ]; then
      MCP_OUT=$(T3CTL_URL="$BASE" T3CTL_MCP_BEARER="$tok" "$T3MCP" "$@" 2>"$errf" <"$inf"); MCP_RC=$?
    else
      MCP_OUT=$(T3CTL_URL="$BASE" T3CTL_MCP_BEARER="$tok" "$T3MCP" "$@" 2>"$errf"); MCP_RC=$?
    fi
    MCP_ERR=$(cat "$errf")
    if [ "$MCP_RC" = 3 ] && [[ $MCP_ERR == *"HTTP 401"* || $MCP_ERR == *"HTTP 403"* ]] && [ -n "${MCP_PINNED:-}" ]; then
      # Mid-dispatch: an earlier attempt may have been accepted, and a fresh
      # credential would not de-duplicate it. Stop instead of re-sending.
      MCP_ERR="$MCP_ERR (the MCP credential was revoked mid-dispatch: this dispatch may be partly sent — check the thread with t3ctl last/show before sending it again)"
      break
    fi
    if [ "$MCP_RC" = 3 ] && [[ $MCP_ERR == *"HTTP 401"* || $MCP_ERR == *"HTTP 403"* ]] && [ "$TOKEN_MODE" = self ] && [ "$attempt" = 1 ]; then
      mint_token mcp "$tok" || { rm -f "$errf" ${inf:+"$inf"}; die "MCP refused the credential and re-minting it failed"; }
      tok=$(mcp_token) || exit 1
      continue
    fi
    break
  done
  rm -f "$errf" ${inf:+"$inf"}
  return "$MCP_RC"
}

mcp_fail() { # $1 = what was attempted; reads MCP_RC/MCP_ERR → a clear t3ctl: error
  local code msg
  case $MCP_RC in
    2) code=$(jq -r '.code // "unknown"' <<<"$MCP_ERR" 2>/dev/null || echo unknown)
       msg=$(jq -r '.message // ""' <<<"$MCP_ERR" 2>/dev/null || echo "$MCP_ERR")
       case $code in
         runtime_mode_escalation_denied|interaction_mode_escalation_denied)
           die "refused by T3 ($code): $msg — t3ctl's MCP credential is capped below this thread's mode (T3CTL_MCP_ACCESS=$MCP_ACCESS; a credential keeps the ceiling it was minted with until it is rotated)";;
         capability_denied) die "refused by T3 ($code): $msg — the MCP credential (access $MCP_ACCESS) does not grant this";;
         thread_not_found) die "no such thread: $msg (t3ctl list)";;
         *) die "T3 refused $1 ($code): $msg";;
       esac;;
    3) case $MCP_ERR in
         *"HTTP 401"*|*"HTTP 403"*)
           if [ "$TOKEN_MODE" = self ]; then die "${MCP_ERR#t3-mcp: } — MCP credential expired or revoked; run: t3ctl token renew"
           else die "${MCP_ERR#t3-mcp: } — MCP credential expired or revoked; run: systemctl start t3-token-renew"; fi;;
         *) die "cannot reach t3's MCP endpoint: ${MCP_ERR#t3-mcp: } — is the t3 server up? (a full disk presents exactly like this: check df -h)";;
       esac;;
    4) die "MCP protocol error during $1: ${MCP_ERR#t3-mcp: } (if this started after a T3_VERSION bump, run t3ctl contract-check)";;
    *) die "t3-mcp $1 failed: $(head -c 600 <<<"$MCP_ERR")";;
  esac
}

mcp() { mcp_raw "$@" || mcp_fail "$1 ${2:-}"; printf '%s' "$MCP_OUT"; }

# V2 run status (an MCP send receipt) → the turn states t3ctl has always reported.
turn_of() {
  case ${1:-} in
    preparing|queued|starting|running|waiting) echo running;;
    completed) echo completed;; failed) echo error;;
    ""|null) echo not-visible;; *) echo interrupted;;
  esac
}

check_mode() {
  case $1 in approval-required|auto-accept-edits|auto|full-access) ;; *)
    die "invalid mode '$1' (approval-required|auto-accept-edits|auto|full-access)";;
  esac
  if [ "$1" = full-access ]; then
    [ "$ALLOW_FULL" = 1 ] || die "full-access is disabled on this deployment (T3CTL_ALLOW_FULL_ACCESS=$ALLOW_FULL)"
    [ "${2:-}" = explicit ] || die "full-access via --mode is refused; pass --full-access if you really mean it"
  fi
  return 0
}

check_dispatch_id() {
  [[ $1 =~ ^[A-Za-z0-9._:-]{8,128}$ ]] || die "--dispatch-id must be 8-128 chars of [A-Za-z0-9._:-] (a receipt's dispatchId)"
}

mode_rank() { case $1 in approval-required) echo 0;; auto-accept-edits) echo 1;; auto) echo 2;; full-access) echo 3;; *) echo 9;; esac; }
check_ceiling() { # $1 mode a thread will run in → refuse before anything is changed
  [ "$(mode_rank "$1")" -le "$(mode_rank "$MCP_ACCESS")" ] || \
    die "refused: t3ctl's MCP credential is capped at $MCP_ACCESS (T3CTL_MCP_ACCESS), so it cannot drive a thread in $1"
}

# Dispatch ledger. T3 de-duplicates a clientRequestId only within the
# credential that sent it, so a --dispatch-id replay after the MCP token was
# rotated would create new work. Every dispatch is reserved (id, kind,
# target, a fingerprint of the credential — never the credential) before it
# is sent and marked accepted once T3 returns its receipt. Lookup,
# validation and reservation happen under one lock; a ledger that cannot be
# read, locked or written refuses the dispatch rather than sending it
# unprotected. Entries are kept 35 days (the MCP credential lives 30).
LEDGER=${T3CTL_DISPATCH_LEDGER:-$MCP_TOKEN_FILE.dispatches}
fingerprint() { printf '%s' "$1" | sha256sum | cut -c1-16; }

ledger_reserve() { # $1 kind, $2 target, $3 dispatch id, $4 credential fingerprint → new|retry|attempted|replay
  local out
  out=$( umask 077
    exec 7>>"$LEDGER.lock" 2>/dev/null || { echo "error:cannot open $LEDGER.lock"; exit 0; }
    flock -w 30 7 || { echo "error:the dispatch ledger $LEDGER has been locked for 30 s"; exit 0; }
    entry=""
    if [ -e "$LEDGER" ]; then
      jq -se 'all(type == "object" and has("dispatchId"))' "$LEDGER" >/dev/null 2>&1 \
        || { echo "error:$LEDGER is not valid (move it aside to continue; replays of the dispatches in it are then unprotected)"; exit 0; }
      entry=$(jq -c --arg d "$3" 'select(.dispatchId == $d)' "$LEDGER" | tail -1)
    fi
    if [ -n "$entry" ]; then
      if [ "$(jq -r .kind <<<"$entry")" != "$1" ] || [ "$(jq -r .target <<<"$entry")" != "$2" ]; then echo "error:conflict"
      elif [ "$(jq -r .credential <<<"$entry")" != "$4" ]; then echo "error:rotated"
      else case $(jq -r .state <<<"$entry") in accepted) echo replay;; attempted) echo attempted;; *) echo retry;; esac; fi
      exit 0
    fi
    { [ ! -s "$LEDGER" ] || jq -c --arg cut "$(date -u -d '-35 days' +%Y-%m-%dT%H:%M:%SZ)" 'select(.at >= $cut)' "$LEDGER"
      jq -cn --arg k "$1" --arg t "$2" --arg d "$3" --arg c "$4" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{dispatchId:$d, kind:$k, target:$t, credential:$c, state:"reserved", at:$at}'
    } > "$LEDGER.tmp" 2>/dev/null && mv "$LEDGER.tmp" "$LEDGER" 2>/dev/null || { echo "error:cannot write $LEDGER"; exit 0; }
    echo new
  )
  case $out in
    new|retry|attempted|replay) printf '%s' "$out";;
    error:conflict) die "refused: dispatch id $3 was already used for another $1 target; pick a new id";;
    error:rotated) die "refused: dispatch $3 was first sent with an MCP credential that has since been rotated, and T3 only de-duplicates within one credential — read the thread (t3ctl last / show) and send again with a new dispatch id only if it is missing";;
    error:*) die "refused to dispatch: ${out#error:}";;
    *) die "refused to dispatch: the dispatch ledger $LEDGER is unusable";;
  esac
}

ledger_mark() { # $1 dispatch id, $2 attempted|accepted (failures only warn: the entry stays protective)
  ( umask 077
    exec 7>>"$LEDGER.lock" && flock -w 30 7 || exit 1
    jq -c --arg d "$1" --arg st "$2" 'if .dispatchId == $d then .state = $st else . end' "$LEDGER" > "$LEDGER.tmp" && mv "$LEDGER.tmp" "$LEDGER"
  ) 2>/dev/null || echo "t3ctl: warning: could not mark dispatch $1 $2 in $LEDGER" >&2
}
ledger_accept() { ledger_mark "$1" accepted; }

begin_dispatch() { # $1 kind, $2 target, $3 dispatch id → REPLAY=1 for an accepted same-credential replay,
  #                  ATTEMPTED=1 when an earlier send of this id may have been accepted (outcome unknown)
  # Pins the credential the ledger was checked against for every MCP call of
  # this dispatch: no re-mint or retry under another credential mid-dispatch.
  local tok state
  tok=$(mcp_token) || exit 1
  state=$(ledger_reserve "$1" "$2" "$3" "$(fingerprint "$tok")") || exit 1
  MCP_PINNED=$tok
  REPLAY=""; [ "$state" != replay ] || REPLAY=1
  ATTEMPTED=""; [ "$state" != attempted ] || ATTEMPTED=1
}

# ---- resolution ------------------------------------------------------------

load_projects() { # → PROJECTS (json array, deleted ones dropped)
  [ -n "${PROJECTS:-}" ] && return 0
  local cursor=0 page all='[]'
  while [ "$cursor" != null ]; do
    page=$(mcp call t3_project_list "{\"limit\":100,\"cursor\":$cursor}") || exit 1
    all=$(jq -c --argjson a "$all" '$a + [.projects[] | select(.deletedAt == null)]' <<<"$page")
    cursor=$(jq -r '.nextCursor // "null"' <<<"$page")
  done
  PROJECTS=$all
}

resolve_thread() { # $1: id or unique prefix → THREAD (normalised json), TID
  local q=$1 m n code
  if mcp_raw thread "$q"; then THREAD=$MCP_OUT; TID=$(jq -r .id <<<"$THREAD"); return 0; fi
  code=$(jq -r '.code // empty' <<<"$MCP_ERR" 2>/dev/null)
  { [ "$MCP_RC" = 2 ] && [ "$code" = thread_not_found ]; } || mcp_fail "read $q"
  # Not a full id: a unique prefix among unarchived threads (one listing).
  m=$(mcp threads --all-projects) || exit 1
  m=$(jq -c --arg q "$q" '[.[] | select(.id | startswith($q))]' <<<"$m")
  n=$(jq length <<<"$m")
  [ "$n" -eq 0 ] && die "no thread matches '$q' (t3ctl list)"
  [ "$n" -gt 1 ] && { jq -r '.[] | "\(.id)  \(.title)"' <<<"$m" >&2; die "'$q' matches $n threads"; }
  mcp_raw thread "$(jq -r '.[0].id' <<<"$m")" || mcp_fail "read $q"
  THREAD=$MCP_OUT; TID=$(jq -r .id <<<"$THREAD")
}

resolve_project() { # $1: id/prefix/title/basename → sets PROJECT, PID
  local q=$1 m n
  load_projects
  m=$(jq -c --arg q "$q" '
      [.[] | select(.id == $q)] as $a
    | [.[] | select(.title == $q or ((.workspaceRoot | split("/") | last) == $q))] as $b
    | [.[] | select(.id | startswith($q))] as $c
    | if ($a|length) > 0 then $a elif ($b|length) > 0 then $b else $c end' <<<"$PROJECTS")
  n=$(jq length <<<"$m")
  [ "$n" -eq 0 ] && die "no project matches '$q' (t3ctl projects)"
  [ "$n" -gt 1 ] && { jq -r '.[] | "\(.id)  \(.title)"' <<<"$m" >&2; die "'$q' matches $n projects"; }
  PROJECT=$(jq -c '.[0]' <<<"$m")
  PID=$(jq -r '.id' <<<"$PROJECT")
}

thread_selection() { # $1 thread id → its full modelSelection (options included)
  mcp call t3_thread_configure "$(jq -cn --arg t "$1" '{threadId:$t}')" | jq -c '.modelSelection'
}

resolve_model() { # $1: model name / instanceId / "instance:model" → selection json
  # Resolved against selections real threads have used on THIS server (most
  # recent wins, options like reasoning effort come along) — no hardcoded
  # model catalog to go stale when t3 or the providers move.
  local q=$1 m tid
  m=$(mcp threads --all-projects --model "$q") || exit 1
  tid=$(jq -r '.[0].id // empty' <<<"$m")
  if [ -n "$tid" ]; then thread_selection "$tid" || exit 1; return; fi
  # Literal instanceId:model — the only way to pick a model on a server no
  # thread has used yet (fresh deployment). No options come along.
  case $q in
    *:*) jq -cn --arg i "${q%%:*}" --arg mo "${q#*:}" '{instanceId:$i, model:$mo}';;
    *) die "no thread on this server has used model '$q' — pick from: $(mcp threads --all-projects --limit 300 | jq -r '[.[].modelSelection | select(.instanceId != null) | (.instanceId + ":" + (.model // ""))] | unique | join(", ")'), or pass a literal instanceId:model";;
  esac
}

require_ours_or_force() { # $1: force flag (true/false)
  [ "$1" = true ] && return 0
  jq -e --arg tag "$TAG" '.title | startswith($tag)' >/dev/null <<<"$THREAD" || \
    die "thread '$(jq -r .title <<<"$THREAD")' was not created by t3ctl ($TAG prefix); this is somebody else's session — pass --force only when explicitly asked to kill it"
}

# ---- commands --------------------------------------------------------------

cmd_projects() {
  load_projects
  jq -c '.[] | {id, title, workspaceRoot, model: (.defaultModelSelection.model // null)}' <<<"$PROJECTS"
}

cmd_models() {
  local rows; rows=$(mcp threads --all-projects) || exit 1
  load_projects
  jq -c --argjson def "$(jq -c '.[0].defaultModelSelection // null' <<<"$PROJECTS")" '
    [.[] | select(.modelSelection.instanceId != null) | {sel: .modelSelection, at: .updatedAt}]
    | group_by(.sel.instanceId + ":" + (.sel.model // ""))
    | map({instanceId: .[0].sel.instanceId, model: .[0].sel.model,
           threads: length, lastUsed: (map(.at) | max),
           projectDefault: ($def != null and .[0].sel.instanceId == $def.instanceId
                            and .[0].sel.model == $def.model)})
    | sort_by(-.threads) | .[]' <<<"$rows"
}

cmd_list() {
  # Default = the app's inbox (unsettled, non-archived): a bare `list` on a
  # long-lived box otherwise returns every thread ever (870 rows). --unarchived
  # is the pre-v0.5 default (settled + unsettled, archived excluded).
  local filter=unsettled rows
  case ${1:-} in --all) filter=all;; --active) filter=active;; --unsettled|"") filter=unsettled;; --unarchived) filter=unarchived;; *) die "unknown flag $1 (list takes --unsettled|--unarchived|--active|--all)";; esac
  [ $# -le 1 ] || die "list takes a single flag"
  # "settled" is server-authoritative: T3 resets it on any real activity, so
  # settled IS the app's settled shelf and everything else is its inbox.
  case $filter in
    all) legacy_list_all; return;;   # MCP's t3_thread_list has no archived threads
    unsettled) rows=$(mcp threads --all-projects --settled false --enrich) || exit 1;;
    unarchived) rows=$(mcp threads --all-projects --enrich) || exit 1;;
    active) rows=$(mcp threads --all-projects --attention) || exit 1;;
  esac
  load_projects
  jq -c --arg f "$filter" --argjson ps "$PROJECTS" '
    ($ps | map({(.id): .title}) | add // {}) as $pt
    | [.[]
       | {id, title,
          project: ($pt[.projectId] // null),
          mode: .runtimeMode,
          session: (.session.status // "none"),
          turn: (.latestTurn.state // "none"),
          settled,
          snoozedUntil: (.snoozedUntil // null),
          pendingApprovals: .hasPendingApprovals,
          pendingUserInput: .hasPendingUserInput,
          lastError: (.session.lastError // null),
          updatedAt}
       | select($f != "active" or .turn == "running" or .pendingApprovals
                or .pendingUserInput or .session == "starting" or .session == "running")
       | select($f != "unsettled" or (.settled | not))]
    | sort_by(.updatedAt) | reverse | .[]' <<<"$rows"
}

# t3-events with this box's event settings (sourced from the conf, so not
# exported): whether a session gets events is decided there, in one place.
EVENTS_DB=${T3CTL_EVENTS_DB:-$T3_HOME/t3ctl-events.sqlite}
EVENTS_LOG=${T3CTL_EVENTS_LOG:-$(dirname "$EVENTS_DB")/t3ctl-events.log}
t3_events() {
  T3CTL_EVENTS_ENABLED="${T3CTL_EVENTS_ENABLED:-0}" T3CTL_EVENTS_ORIGINS="${T3CTL_EVENTS_ORIGINS:-}" T3CODE_HOME="$T3_HOME" \
    T3CTL_EVENTS_DB="$EVENTS_DB" T3CTL_EVENTS_LOG="$EVENTS_LOG" "$HERE/t3-events" "$@"
}

events_log_fallback() { # $1 receipt, $2 reason — when t3-events itself could not log
  # Names of the session variables only, never their values.
  local present
  present=$(compgen -e | grep '^HERMES_SESSION_' | while read -r v; do [ -n "${!v}" ] && echo "$v"; done | jq -Rsc 'split("\n") | map(select(length > 0)) | sort')
  { mkdir -p "$(dirname "$EVENTS_LOG")" && jq -cn --argjson r "$1" --arg reason "$2" --arg ts "$(now)" \
      --arg platform "${HERMES_SESSION_PLATFORM:-}" --argjson present "$present" \
      '{ts:$ts, threadId:$r.threadId, dispatchId:$r.dispatchId, platform:(if $platform == "" then null else $platform end),
        monitoring:"manual", reason:$reason, present:$present}' >> "$EVENTS_LOG"; } 2>/dev/null || true
}

register_events() {
  # Every manual fallback names its reason (monitoringReason, variable names
  # only) and every decision is logged beside the events DB, so the next
  # "came back manual" is diagnosable without guessing.
  local receipt result monitoring=manual reason=""
  receipt=$(cat)
  if [ -x "$HERE/t3-events" ]; then
    if result=$(printf '%s' "$receipt" | t3_events register); then
      if [ "$(jq -r .registered <<<"$result")" = true ]; then monitoring=events
      else reason=$(jq -r '.reason // "registration-error"' <<<"$result"); fi
    else
      reason=registration-error
      echo "t3ctl: event registration failed; task was dispatched, use watch with messageId" >&2
      events_log_fallback "$receipt" "$reason"
    fi
  else
    reason=relay-not-installed
    [ "${T3CTL_EVENTS_ENABLED:-0}" != 1 ] || events_log_fallback "$receipt" "$reason"
  fi
  jq -c --arg monitoring "$monitoring" --arg reason "$reason" \
    '. + {monitoring:$monitoring} + (if $monitoring == "manual" then {monitoringReason:$reason} else {} end)' <<<"$receipt"
}

read_prompt() { # $1 path or - → PROMPT_TEXT (verbatim, trailing newlines kept)
  PROMPT_TEXT=$(cat -- "$1" && printf .) || die "cannot read prompt file"
  PROMPT_TEXT=${PROMPT_TEXT%.}
}

send_message() { # $1 thread id, $2 text, $3 dispatch id → MCP send receipt
  # `queue`: an idle thread starts at once, a busy one gets a follow-up run
  # after the active one — a message never steers a running turn.
  # clientRequestId = dispatchId: T3 derives the message id from it, so a
  # retry (lost response, --dispatch-id) returns the same message, not a second one.
  printf '%s' "$2" | jq -Rsc --arg tid "$1" --arg rid "$3" '{threadId:$tid, message:., mode:"queue", clientRequestId:$rid}' \
    | mcp call t3_thread_send - --retry
}

cmd_new() {
  local project="" prompt="" prompt_file="" title="" mode=$DEFAULT_MODE imode=default explicit="" model="" dispatch_id=""
  [ "$mode" = full-access ] && explicit=explicit   # deployment default, already gated above
  while [ $# -gt 0 ]; do case $1 in
    --title) title=$2; shift 2;;
    --plan) imode=plan; shift;;
    --execute) imode=default; shift;;
    --prompt-file) [ -n "${2:-}" ] || die "--prompt-file requires a path or -"; prompt_file=$2; shift 2;;
    --model) model=$2; shift 2;;
    --dispatch-id) check_dispatch_id "${2:-}"; dispatch_id=$2; shift 2;;
    --mode) check_mode "$2"
            if [ -n "$MODE_FIXED" ] && [ "$2" != "$DEFAULT_MODE" ]; then
              die "this deployment fixes the mode of new threads to $DEFAULT_MODE (T3CTL_DEFAULT_MODE); drop --mode and run \`new\` again"
            fi
            mode=$2; shift 2;;
    --full-access) [ "$ALLOW_FULL" = 1 ] || die "full-access is disabled on this deployment (T3CTL_ALLOW_FULL_ACCESS=$ALLOW_FULL)"; mode=full-access; explicit=explicit; shift;;
    -*) die "unknown flag $1";;
    *) if [ -z "$project" ]; then project=$1; elif [ -z "$prompt" ]; then prompt=$1; else die "unexpected arg: $1"; fi; shift;;
  esac; done
  if [ -n "$prompt_file" ]; then
    [ -z "$prompt" ] || die "use either prompt text or --prompt-file"
    read_prompt "$prompt_file"; prompt=$PROMPT_TEXT
  fi
  [ -n "$project" ] && [ -n "$prompt" ] || die "usage: t3ctl new <project> \"<prompt>\""
  [ "$mode" = full-access ] && [ -z "$explicit" ] && die "full-access needs --full-access"

  check_ceiling "$mode"
  resolve_project "$project"
  [ -n "$dispatch_id" ] || dispatch_id=$(uuid)
  begin_dispatch new "$PID" "$dispatch_id"
  # An accepted replay of a dispatch that already passed the cap returns that same work.
  if [ -z "$REPLAY" ]; then
    local running
    running=$(mcp threads --all-projects --statuses "$ACTIVE_STATUSES" --title-contains "$TAG") || exit 1
    running=$(jq --arg tag "$TAG" '[.[] | select(.title | startswith($tag))] | length' <<<"$running")
    [ "$running" -ge "$MAX_RUNNING" ] && \
      die "$running $TAG turns already running (limit $MAX_RUNNING) — finish or interrupt one first, or raise T3CTL_MAX_RUNNING"
  fi

  # model: --model wins, else project default, else the most recent thread's
  local msel last
  if [ -n "$model" ]; then
    msel=$(resolve_model "$model") || exit 1
  else
    msel=$(jq -c '.defaultModelSelection // empty' <<<"$PROJECT")
    if [ -z "$msel" ]; then
      last=$(mcp threads --project "$PID" --limit 1) || exit 1
      last=$(jq -r '.[0].id // empty' <<<"$last")
      [ -z "$last" ] || msel=$(thread_selection "$last") || exit 1
    fi
    [ -n "$msel" ] || die "project has no defaultModelSelection and no prior thread to copy one from"
  fi

  [ -n "$title" ] || title="${prompt:0:48}"
  case $title in "$TAG"*) ;; *) title="$TAG $title";; esac

  # Created idle first: the callback contract below needs the thread id,
  # which T3 derives from the clientRequestId (a retry returns the same thread).
  local launched tid
  launched=$(jq -cn --arg pid "$PID" --arg title "$title" --argjson msel "$msel" --arg mode "$mode" \
                    --arg imode "$imode" --arg rid "$dispatch_id" '
    {projectId:$pid, title:$title, modelSelection:$msel, runtimeMode:$mode,
     interactionMode:$imode, workspaceStrategy:{type:"root"}, clientRequestId:$rid}' \
    | mcp call t3_thread_launch - --retry) || exit 1
  tid=$(jq -r '.threadId // empty' <<<"$launched")
  [ -n "$tid" ] || die "t3_thread_launch returned no threadId"

  # Callback + scheduling contract for the agent inside the session. The
  # thread id is only known here, so t3ctl injects it rather than the skill.
  if [ -x "$HERE/t3-events" ] && t3_events eligible; then
    prompt="$prompt

T3 state changes are monitored by the gateway and returned to the dispatching conversation. Do not call $NOTIFY_CMD or create polling/scheduling jobs."
  elif command -v "$NOTIFY_CMD" >/dev/null 2>&1; then
    prompt="$prompt

---
Callback contract (from the dispatcher, not the task): this t3 thread's id is $tid. When you FINISH the task, become BLOCKED, or are WAITING on an approval, report it with:
  $NOTIFY_CMD --thread $tid --status done|blocked|approval \"<one-paragraph summary>\"
Run it as a plain command exactly in that form (double-quoted summary, no other shell syntax): that exact command is pre-approved and runs without a prompt even in approval-required mode. Notify on those state changes only — not for progress updates. Also: never schedule recurring jobs (cron, timers, self-reminders) from inside this session; they die with it. If the work needs something recurring, say so in your callback and it will be scheduled properly outside."
  fi
  local sent state
  ledger_mark "$dispatch_id" attempted
  sent=$(send_message "$tid" "$prompt" "$dispatch_id") || exit 1
  ledger_accept "$dispatch_id"
  state=$(turn_of "$(jq -r 'if .runId == null then "" else .status end' <<<"$sent")")
  jq -cn --arg id "$tid" --arg title "$title" --arg mode "$mode" --arg state "$state" --argjson sent "$sent" \
         --arg dispatch_id "$dispatch_id" --argjson msel "$msel" \
    '{threadId:$id, title:$title, mode:$mode, model:$msel.model, turn:$state,
      turnId:(if $state == "not-visible" then null else $sent.runId end), previousTurnId:"none",
      dispatchId:$dispatch_id, messageId:$sent.messageId}' | register_events
}

cmd_say() {
  # Continuing a thread inherits ITS runtime mode by default: owned threads
  # were created approval-required, and other people's threads keep whatever
  # they chose — a follow-up must not quietly downgrade (or upgrade) a session.
  local thread="" text="" prompt_file="" mode="" imode="" model="" msel="" expect_turn="" dispatch_id=""
  while [ $# -gt 0 ]; do case $1 in
    --expect-turn) [ -n "${2:-}" ] || die "--expect-turn requires a turn id (or none)"; expect_turn=$2; shift 2;;
    --plan) imode=plan; shift;;
    --execute) imode=default; shift;;
    --prompt-file) [ -n "${2:-}" ] || die "--prompt-file requires a path or -"; prompt_file=$2; shift 2;;
    --model) model=$2; shift 2;;
    --dispatch-id) check_dispatch_id "${2:-}"; dispatch_id=$2; shift 2;;
    --mode) check_mode "$2"; mode=$2; shift 2;;
    --full-access) [ "$ALLOW_FULL" = 1 ] || die "full-access is disabled on this deployment (T3CTL_ALLOW_FULL_ACCESS=$ALLOW_FULL)"; mode=full-access; shift;;
    --inherit) shift;;   # inherit is the default; flag kept for compatibility
    -*) die "unknown flag $1";;
    *) if [ -z "$thread" ]; then thread=$1; elif [ -z "$text" ]; then text=$1; else die "unexpected arg: $1"; fi; shift;;
  esac; done
  if [ -n "$prompt_file" ]; then
    [ -z "$text" ] || die "use either prompt text or --prompt-file"
    read_prompt "$prompt_file"; text=$PROMPT_TEXT
  fi
  [ -n "$thread" ] && [ -n "$text" ] || die "usage: t3ctl say <thread> \"<text>\""
  resolve_thread "$thread"
  # One sender at a time per thread, held until the new run is visible, so a
  # second sender's --expect-turn check sees the first one's turn. Without
  # it, two Hermes sessions woken by the same completion (relay, callback,
  # a background watch) each sent their own follow-up to the same thread —
  # 1.6 s apart on 2026-10-10.
  local lockdir=${T3CTL_LOCK_DIR:-/tmp/t3ctl-locks-$(id -u)} lockname
  mkdir -p "$lockdir" && chmod 700 "$lockdir" || die "cannot create lock dir $lockdir"
  lockname=$(printf '%s' "$TID" | tr -c 'A-Za-z0-9._-' '_')
  exec 8>"$lockdir/say-$lockname.lock"
  flock -w 120 8 || die "another t3ctl say to thread $TID has held its lock for 120 s"
  resolve_thread "$TID"   # re-read: the state may have moved while we waited
  local cur_mode cur_imode cur_sel=""
  cur_mode=$(jq -r '.runtimeMode' <<<"$THREAD"); cur_imode=$(jq -r '.interactionMode // "default"' <<<"$THREAD")
  [ -n "$mode" ] || mode=$cur_mode
  [ -n "$imode" ] || imode=$cur_imode
  check_ceiling "$mode"   # before anything changes: MCP would refuse the message after the mode was set
  [ -z "$model" ] || msel=$(resolve_model "$model") || exit 1
  [ -z "$msel" ] || cur_sel=$(thread_selection "$TID") || exit 1   # read before anything changes
  local old; old=$(jq -r '.latestTurn.turnId // "none"' <<<"$THREAD")
  [ -n "$dispatch_id" ] || dispatch_id=$(uuid)
  begin_dispatch say "$TID" "$dispatch_id"
  # An accepted same-credential replay returns that message; its own send is
  # what moved the thread past --expect-turn.
  if [ -n "$expect_turn" ] && [ -z "$REPLAY" ]; then
    local cur_turn; cur_turn=$(jq -r '.latestTurn.turnId // "none"' <<<"$THREAD")
    [ "$cur_turn" = "$expect_turn" ] || die "refused: thread $TID has moved past turn $expect_turn (latest is now $cur_turn) — someone else already sent a turn; read it (t3ctl last $TID) before deciding whether to send anything"
  fi
  # The model is set over MCP while the modes are still the thread's own (MCP
  # checks the thread's modes against the credential's ceiling); mode changes
  # are thread state MCP will not set, so they go over the legacy path, last.
  # Any failure after the first change puts back what was changed: modes
  # first (down again), then the model.
  local set_mode="" set_imode="" model_set=""
  # An accepted replay, or a retry of a send that may have been accepted,
  # only recovers its receipt: the settings it asked for were applied then,
  # and re-applying them now could undo a later dispatch's.
  if [ -z "$REPLAY$ATTEMPTED" ]; then
    [ "$mode" = "$cur_mode" ] || set_mode=$mode
    [ "$imode" = "$cur_imode" ] || set_imode=$imode
  else
    msel=""
  fi
  say_restore() {
    echo "t3ctl: the message was not sent; restoring the thread's previous settings" >&2
    if [ -n "$set_mode$set_imode" ]; then
      ( legacy_set_modes "$TID" "${set_mode:+$cur_mode}" "${set_imode:+$cur_imode}" ) \
        || echo "t3ctl: warning: could not restore the thread's modes ($cur_mode/$cur_imode)" >&2
    fi
    if [ -n "$model_set" ]; then
      mcp_raw call t3_thread_configure "$(jq -cn --arg t "$TID" --argjson m "$cur_sel" '{threadId:$t, modelSelection:$m}')" >/dev/null \
        || echo "t3ctl: warning: could not restore the thread's model" >&2
    fi
  }
  if [ -n "$msel" ]; then
    mcp_raw call t3_thread_configure "$(jq -cn --arg t "$TID" --argjson m "$msel" '{threadId:$t, modelSelection:$m}')" \
      || mcp_fail "t3_thread_configure"   # nothing changed yet
    model_set=1
  fi
  if [ -n "$set_mode$set_imode" ]; then
    ( legacy_set_modes "$TID" "$set_mode" "$set_imode" ) || { say_restore; exit 1; }
  fi
  local sent state
  # Only a refusal T3 makes before accepting (the codes below) proves the
  # message was not sent. After any other failure (a transport error, a lost
  # reply, orchestration_error, which T3 can return after dispatching) it may
  # be running: the requested settings stay, the caller is told delivery is
  # uncertain, and the ledger marks the id attempted so a retry changes nothing.
  ledger_mark "$dispatch_id" attempted
  if ! mcp_raw call t3_thread_send - --retry < <(printf '%s' "$text" | jq -Rsc --arg tid "$TID" --arg rid "$dispatch_id" \
        '{threadId:$tid, message:., mode:"queue", clientRequestId:$rid}'); then
    if [ "$MCP_RC" = 2 ] && [[ $(jq -r '.code // ""' <<<"$MCP_ERR" 2>/dev/null) =~ ^(runtime_mode_escalation_denied|interaction_mode_escalation_denied|capability_denied|thread_not_found|thread_not_sendable|invalid_request|parent_not_active)$ ]]; then
      ledger_mark "$dispatch_id" reserved   # refused outright: nothing of it exists
      local send_rc=$MCP_RC send_err=$MCP_ERR   # say_restore's own calls overwrite them
      say_restore; MCP_RC=$send_rc; MCP_ERR=$send_err; mcp_fail t3_thread_send
    fi
    [ -z "$set_mode$set_imode$model_set" ] || echo "t3ctl: the thread keeps the settings this say asked for (delivery is uncertain, so they were not rolled back)" >&2
    MCP_ERR="$MCP_ERR — delivery of dispatch $dispatch_id is uncertain: check the thread (t3ctl last $TID) before sending again; a retry with --dispatch-id $dispatch_id cannot duplicate it while the credential is unchanged"
    mcp_fail t3_thread_send
  fi
  sent=$MCP_OUT
  ledger_accept "$dispatch_id"
  state=$(turn_of "$(jq -r 'if .runId == null then "" else .status end' <<<"$sent")")
  exec 8>&-   # new run visible (or given up on): next sender may check
  jq -cn --arg id "$TID" --arg mode "$mode" --arg state "$state" --argjson sent "$sent" --arg old "$old" --arg dispatch_id "$dispatch_id" \
    '{threadId:$id, mode:$mode, turn:$state, turnId:(if $state == "not-visible" then null else $sent.runId end),
      previousTurnId:$old, dispatchId:$dispatch_id, messageId:$sent.messageId}' | register_events
}

cmd_answer() {
  [ "$#" -eq 4 ] && [ "$3" = --answers-file ] || die "usage: t3ctl answer <thread> <requestId> --answers-file <path|->"
  local thread=$1 request=$2 answers
  answers=$(cat -- "$4") || die "cannot read answers file"
  jq -e 'type == "object"' >/dev/null <<<"$answers" 2>/dev/null || die "answers must be a JSON object keyed by question id"
  resolve_thread "$thread"
  mcp_raw call t3_pending_request "$(jq -cn --arg t "$TID" --arg r "$request" '{action:"read", threadId:$t, requestId:$r}')" \
    || die "request is not pending on this thread"
  jq -c --arg t "$TID" --arg r "$request" '{action:"respond", threadId:$t, requestId:$r, answers:.}' <<<"$answers" \
    | mcp call t3_pending_request - || exit 1
  echo
}

cmd_show() {
  local thread="" turns=4
  while [ $# -gt 0 ]; do case $1 in
    -n) num -n "${2:-}"; turns=$2; shift 2;;
    -*) die "unknown flag $1";;
    *) [ -z "$thread" ] && thread=$1 || die "unexpected arg: $1"; shift;;
  esac; done
  [ -n "$thread" ] || die "usage: t3ctl show <thread> [-n turns]"
  resolve_thread "$thread"
  local d legacy ui ap
  d=$(mcp messages "$TID" --runs "$turns" --cap "$TEXT_CAP" --with-error) || exit 1
  # The exact command behind an approval needs item correlation MCP lacks,
  # and MCP's pending questions carry no responseMode: both from the legacy detail.
  legacy=$(legacy_thread_detail "$TID") || exit 1
  ap=$(jq -c '.thread.approvals' <<<"$legacy"); ui=$(jq -c '.thread.userInputs' <<<"$legacy")
  jq --argjson cap "$TEXT_CAP" --argjson ui "$ui" --argjson ap "$ap" '
    .thread as $t | {id: $t.id, title: $t.title, mode: $t.runtimeMode, interaction: $t.interactionMode,
      session: $t.session,
      latestTurn: $t.latestTurn,
      userInputs: $ui,
      approvals: $ap,
      messages: [.messages[] | {role, createdAt,
                  text: (if $cap > 0 and (.text|length) > $cap then (.text[:$cap] + "…[truncated]") else .text end)}]}' <<<"$d"
}

cmd_last() {
  # The thread's latest assistant reply, whole and as plain text — the thing
  # `show | python -c …` was used for. --json adds the turn it belongs to, so
  # the reader can pass that turn to `say --expect-turn`.
  local thread="" json=false
  while [ $# -gt 0 ]; do case $1 in
    --json) json=true; shift;;
    -*) die "unknown flag $1";;
    *) [ -z "$thread" ] && thread=$1 || die "unexpected arg: $1"; shift;;
  esac; done
  [ -n "$thread" ] || die "usage: t3ctl last <thread> [--json]"
  resolve_thread "$thread"
  local out; out=$(mcp messages "$TID" --runs 4) || exit 1
  out=$(jq -c '{threadId: .thread.id, turnId: (.thread.latestTurn.turnId // null), turn: (.thread.latestTurn.state // "none"),
       text: ([.messages[] | select(.role == "assistant")] | last | .text // null)}' <<<"$out")
  if [ "$json" = true ]; then printf '%s\n' "$out"; return; fi
  jq -e '.text != null' >/dev/null <<<"$out" || die "thread $TID has no assistant reply in its recent turns"
  jq -j '.text' <<<"$out"; echo
}

cmd_search() {
  # t3_thread_search: titles (and branch/PR/project) first, then message text.
  local q="" limit=20 rows
  while [ $# -gt 0 ]; do case $1 in
    --limit) num --limit "${2:-}"; limit=$2; shift 2;;
    -*) die "unknown flag $1";;
    *) [ -z "$q" ] && q=$1 || die "unexpected arg: $1"; shift;;
  esac; done
  [ ${#q} -ge 2 ] || die "usage: t3ctl search \"<text>\" (min 2 chars)"
  [ ${#q} -le 200 ] || die "search text is limited to 200 chars"
  rows=$(mcp search "$q" --limit "$(( limit > 50 ? 50 : (limit < 1 ? 1 : limit) ))") || exit 1
  load_projects
  jq -c --argjson ps "$PROJECTS" --argjson limit "$limit" '
    ($ps | map({(.id): .title}) | add // {}) as $pt
    | [.[] | {threadId, title, project: ($pt[.projectId] // null), matchedIn: .source, snippet}
             + (if .messageCreatedAt then {messageCreatedAt} else {} end) + {updatedAt}]
    | .[:$limit] | .[]' <<<"$rows"
}

cmd_approvals() {
  [ $# -ge 1 ] || die "usage: t3ctl approvals <thread>"
  resolve_thread "$1"
  legacy_approvals "$TID"
}

cmd_watch() {
  local thread="" timeout=900 interval=5 after_turn="" message_id="" expected_turn="" latest
  while [ $# -gt 0 ]; do case $1 in
    --message-id) [ -n "${2:-}" ] || die "--message-id requires a message id"; message_id=$2; shift 2;;
    --after-turn) [ -n "${2:-}" ] || die "--after-turn requires a turn id"; after_turn=$2; shift 2;;
    --timeout) num --timeout "${2:-}"; timeout=$2; shift 2;;
    --interval) num --interval "${2:-}"; interval=$2; shift 2;;
    -*) die "unknown flag $1";;
    *) [ -z "$thread" ] && thread=$1 || die "unexpected arg: $1"; shift;;
  esac; done
  [ -n "$thread" ] || die "usage: t3ctl watch <thread> [--message-id ID] [--timeout s]"
  resolve_thread "$thread"
  local deadline=$((SECONDS + timeout)) grace=$((SECONDS + 60)) reason="" t=$THREAD state slice
  while :; do
    latest=$(jq -r '.latestTurn.turnId // "none"' <<<"$t")
    if [ -n "$message_id" ]; then
      # the run this message started (T3's user-message item records its run)
      expected_turn=$(mcp run-of-message "$TID" "$message_id") || exit 1
      expected_turn=$(jq -r '.runId // "none"' <<<"$expected_turn")
      if [ "$expected_turn" = none ]; then
        [ $SECONDS -ge $deadline ] && { reason=not-visible; break; }
        sleep "$interval"; t=$(mcp thread "$TID") || exit 1
        continue
      fi
      [ "$latest" = "$expected_turn" ] || { reason=superseded; break; }
    fi
    if [ -n "$after_turn" ] && [ "$latest" = "$after_turn" ]; then
      [ $SECONDS -ge $deadline ] && { reason=not-visible; break; }
      sleep "$interval"; t=$(mcp thread "$TID") || exit 1
      continue
    fi
    if jq -e '.hasPendingApprovals' >/dev/null <<<"$t"; then reason=pending-approval; break; fi
    if jq -e '.hasPendingUserInput' >/dev/null <<<"$t"; then reason=pending-user-input; break; fi
    state=$(jq -r '.latestTurn.state // "none"' <<<"$t")
    if [ "$state" = none ]; then
      # A just-dispatched turn takes a moment to reach the projection —
      # don't call that "settled". After the grace window it really is idle.
      [ $SECONDS -ge $grace ] && { reason=no-turn; break; }
    elif [ "$state" != running ]; then
      reason=settled; break
    fi
    [ $SECONDS -ge $deadline ] && { reason=timeout; break; }
    if [ "$state" = running ]; then
      # Block server-side until the run ends. t3_thread_wait does not return
      # for a pending approval or question, so wait in slices and look again.
      slice=$((deadline - SECONDS)); [ $slice -gt "$WATCH_SLICE" ] && slice=$WATCH_SLICE; [ $slice -lt 1 ] && slice=1
      mcp call t3_thread_wait "$(jq -cn --arg t "$TID" --arg r "$latest" --argjson ms $((slice * 1000)) '{threadId:$t, runId:$r, timeoutMs:$ms}')" \
        --timeout $((slice + 30)) >/dev/null || exit 1
    else
      sleep "$interval"
    fi
    t=$(mcp thread "$TID") || exit 1
  done
  local d legacy ui='[]' ap='[]'
  d=$(mcp messages "$TID" --runs 1 --cap "$TEXT_CAP" --with-error) || exit 1
  if [ "$reason" != not-visible ] && [ "$(jq -r '.latestTurn.turnId' <<<"$t")" != "$(jq -r '.thread.latestTurn.turnId' <<<"$d")" ]; then reason=superseded; fi
  # Pending requests in full (approval commands, question responseMode) only
  # exist on the legacy detail; read it only when something is pending.
  if jq -e '.thread.hasPendingUserInput or .thread.hasPendingApprovals' >/dev/null <<<"$d"; then
    legacy=$(legacy_thread_detail "$TID") || exit 1
    case $reason in not-visible|superseded) ;; *) ui=$(jq -c '.thread.userInputs' <<<"$legacy");; esac
    case $reason in pending-approval|pending-user-input)
      ap=$(jq -c '[.thread.approvals[] | select(.payload.status == "pending")]' <<<"$legacy");; esac
  fi
  printf '%s\n%s\n' "$t" "$d" | jq -s --arg reason "$reason" --argjson cap "$TEXT_CAP" --argjson ui "$ui" --argjson ap "$ap" '
    .[0] as $t | .[1] as $d |
    {turnId: $t.latestTurn.turnId, userInputs: $ui, reason: $reason,
     turn: (if $reason == "superseded" then "superseded" else ($t.latestTurn.state // "none") end),
     lastError: ($d.thread.session.lastError // null),
     approvals: $ap,
     lastAssistant: (if $reason == "not-visible" or $reason == "superseded" then null else ([$d.messages[] | select(.role == "assistant")] | last
                     | if . == null then null
                       elif $cap > 0 and (.text|length) > $cap then (.text[:$cap] + "…[truncated]")
                       else .text end) end)}'
}

simple_thread_cmd() { # $1: interrupt|stop|rm|settle|unsettle, then thread + flags
  local name=$1; shift
  local thread="" force=false out
  while [ $# -gt 0 ]; do case $1 in
    --force) force=true; shift;;
    -*) die "unknown flag $1";;
    *) [ -z "$thread" ] && thread=$1 || die "unexpected arg: $1"; shift;;
  esac; done
  [ -n "$thread" ] || die "usage: t3ctl $name <thread> [--force]"
  resolve_thread "$thread"
  # settle/unsettle are reversible inbox state, not session-killing — no
  # ownership guard. The server still refuses to settle a thread that is
  # running or blocked on an approval/user-input request.
  case $name in settle|unsettle) ;; *) require_ours_or_force "$force";; esac
  local run; run=$(jq -r '.activeRunId // empty' <<<"$THREAD")
  case $name in
    settle|unsettle)
      mcp call t3_thread_organize "$(jq -cn --arg t "$TID" --arg a "$name" '{threadId:$t, action:$a}')" >/dev/null || exit 1;;
    interrupt)
      [ -n "$run" ] || die "thread has no active run to interrupt"
      out=$(mcp call t3_thread_interrupt "$(jq -cn --arg t "$TID" --arg r "$run" '{threadId:$t, runId:$r}')") || exit 1
      [ "$(jq -r .status <<<"$out")" != no_active_run ] || die "thread has no active run to interrupt";;
    stop) legacy_stop "$TID" "$run" || exit 1;;
    rm) legacy_rm "$TID" || exit 1;;
  esac
  jq -cn --arg id "$TID" --arg op "$name" '{threadId:$id, op:$op, done:true}'
}

cmd_token() {
  case ${1:-status} in
    status)
      local code="" mvalid=false
      if [ -s "$TOKEN_FILE" ]; then
        code=$(curl -s -m 15 -o /dev/null -w '%{http_code}' \
          -H @<(auth_hdr "$(tr -d ' \t\n' < "$TOKEN_FILE")") -H "$PROTO_HDR" "$BASE/api/orchestration/shell" || echo 000)
      fi
      [ -s "$MCP_TOKEN_FILE" ] && probe_token mcp "$(tr -d ' \t\n' < "$MCP_TOKEN_FILE")" && mvalid=true
      jq -cn --arg f "$TOKEN_FILE" --arg sid "$(cat "$SESSION_FILE" 2>/dev/null)" --arg code "$code" --arg mode "$TOKEN_MODE" \
             --arg mf "$MCP_TOKEN_FILE" --arg msid "$(cat "$MCP_SESSION_FILE" 2>/dev/null)" --argjson mvalid "$mvalid" --arg access "$MCP_ACCESS" '
        {tokenFile:$f, sessionId:$sid,
         probe:(if $code == "" then null else ($code|tonumber) end), valid:($code=="200"), mode:$mode,
         mcp:{tokenFile:$mf, sessionId:$msid, valid:$mvalid, access:$access}}';;
    renew)
      [ "$TOKEN_MODE" = self ] || die "T3CTL_TOKEN_MODE=$TOKEN_MODE: this box rotates the tokens with t3-token-renew (systemctl start t3-token-renew)"
      mint_token rpc "$(tr -d ' \t\n' < "$TOKEN_FILE" 2>/dev/null)" || exit 1
      mint_token mcp "$(tr -d ' \t\n' < "$MCP_TOKEN_FILE" 2>/dev/null)" || exit 1
      jq -cn --arg f "$TOKEN_FILE" --arg sid "$(cat "$SESSION_FILE" 2>/dev/null)" \
             --arg mf "$MCP_TOKEN_FILE" --arg msid "$(cat "$MCP_SESSION_FILE" 2>/dev/null)" \
        '{tokenFile:$f, sessionId:$sid, renewed:true, mcp:{tokenFile:$mf, sessionId:$msid, renewed:true}}';;
    *) die "usage: t3ctl token [status|renew]";;
  esac
}

cmd_contract_check() {
  # Every contract this build depends on, exercised read-only, so a t3
  # version bump fails here instead of inside a thread. Extend when a new
  # tool/endpoint/field is used. Complements `selftest` (end-to-end, costs a turn).
  local probe tl tid rd meta legacy
  mcp_raw probe --t3ctl
  case $MCP_RC in
    0) probe=$MCP_OUT;;
    1) die "T3's MCP endpoint lacks tools t3ctl calls: $(jq -r '.missing | join(", ")' <<<"$MCP_OUT") (server $(jq -r '.serverInfo.version // "?"' <<<"$MCP_OUT")) — see docs/COMPAT.md";;
    *) mcp_fail "MCP initialize/tools/list";;
  esac
  tl=$(mcp call t3_thread_list '{"allProjects":true,"limit":1}') || exit 1
  jq -e '(.threads | type == "array") and has("nextCursor") and has("total")' >/dev/null <<<"$tl" || die "t3_thread_list result shape changed"
  tid=$(jq -r '.threads[0].threadId // empty' <<<"$tl")
  if [ -n "$tid" ]; then
    jq -e '.threads[0] | has("latestRunId") and has("status") and has("runtimeMode") and has("interactionMode")
             and has("settled") and has("snoozedUntil") and has("updatedAt") and has("providerInstanceId") and has("model")' >/dev/null <<<"$tl" \
      || die "t3_thread_list thread fields changed (latestRunId/status/runtimeMode/settled/…)"
    rd=$(mcp call t3_thread_read "$(jq -cn --arg t "$tid" '{threadId:$t, limit:2, maxCharsPerItem:1}')") || exit 1
    jq -e '(.thread | has("latestRunId") and has("activeRunId") and has("pendingRequestCount") and has("itemCount") and has("archived"))
           and (.recentRuns | type == "array") and (.items | type == "array") and has("nextPosition") and has("hasMore")
           and ((.items[0] // {runId:null, type:"", messageId:null, textTruncated:false, updatedAt:""}) | has("runId") and has("type") and has("textTruncated"))' >/dev/null <<<"$rd" \
      || die "t3_thread_read result shape changed (thread/recentRuns/items)"
  fi
  # Minting the MCP credential uses T3's OAuth endpoints (the approval
  # itself needs a pairing code, so only the metadata is checked here).
  meta=$(curl -sf -m 15 "$BASE/.well-known/oauth-authorization-server") || die "GET /.well-known/oauth-authorization-server failed: the MCP credential cannot be re-minted"
  jq -e '(.registration_endpoint | test("/oauth/mcp/register$")) and (.token_endpoint | test("/oauth/mcp/token$"))
         and (.grant_types_supported | index("authorization_code")) and (.code_challenge_methods_supported | index("S256"))' >/dev/null <<<"$meta" \
    || die "MCP OAuth metadata changed (register/token endpoints, authorization_code, S256)"
  legacy=$(legacy_contract_check) || exit 1
  jq -cn --arg base "$BASE" --argjson probe "$probe" --argjson legacy "$legacy" \
    '{ok:true, base:$base} + $legacy
     + {mcp:{server:$probe.serverInfo.version, protocolVersion:$probe.protocolVersion, tools:$probe.tools,
             required:$probe.required, missing:$probe.missing}, oauth:true}'
}

cmd_selftest() {
  # What a human did by hand on 2026-09-08 to prove the Hermes leg works:
  # create a tagged thread, get PONG, force the callback command, see the
  # approver accept it unattended, delete the probe. Run after a T3_VERSION
  # bump and on every new box. Costs one tiny model turn.
  local project="" tid="" fail=0 t0 pong_s="" cb_s="" reason ans w
  while [ $# -gt 0 ]; do case $1 in
    --project) project=$2; shift 2;;
    *) die "usage: t3ctl selftest [--project <project>]";;
  esac; done
  load_projects
  [ -n "$project" ] || project=$(jq -r '.[0].title // empty' <<<"$PROJECTS")
  [ -n "$project" ] || die "selftest: no project on this server"
  command -v "$NOTIFY_BIN" >/dev/null 2>&1 || die "selftest: $NOTIFY_BIN is not installed — the callback leg cannot work"

  t0=$SECONDS
  # The probe is always approval-required, whatever the deployment default:
  # in full-access the callback never raises an approval, so the approver
  # leg this exists to prove would go untested.
  w=$(DEFAULT_MODE=approval-required MODE_FIXED="" cmd_new "$project" "Connectivity self-test. Reply with exactly the word PONG and nothing else. Do not run tools, do not read or edit files." --title "selftest $(date -u +%Y-%m-%dT%H:%M:%SZ)") || die "selftest: new failed"
  tid=$(jq -r .threadId <<<"$w")
  echo "selftest: thread $tid" >&2
  w=$(cmd_watch "$tid" --timeout 120)
  reason=$(jq -r .reason <<<"$w")
  # Some models run the callback right after PONG (the footer asks for it on
  # completion). That pending approval is the approver's to accept — keep
  # watching until the turn really settles instead of calling it a failure.
  local deadline=$((SECONDS + 150))
  while [ "$reason" = pending-approval ] || [ "$reason" = timeout ]; do
    [ $SECONDS -ge $deadline ] && break
    w=$(cmd_watch "$tid" --timeout 20); reason=$(jq -r .reason <<<"$w")
  done
  ans=$(jq -r '.lastAssistant // ""' <<<"$w")
  if [ "$reason" = settled ] && [[ $ans == *PONG* ]]; then pong_s=$((SECONDS - t0)); else fail=1; echo "selftest: PONG leg failed ($reason): $w" >&2; fi

  # If the model already called back during the PONG leg and the approver
  # accepted it, the callback leg is proven — do not force a second one.
  local early_acc=0
  if [ $fail -eq 0 ]; then
    early_acc=$(cmd_approvals "$tid" | jq -s '[.[] | select(.payload.decision == "accept")] | length')
  fi
  if [ $fail -eq 0 ] && [ "$early_acc" -ge 1 ]; then
    cb_s="0"; echo "selftest: callback already made and auto-approved during the PONG leg" >&2
  elif [ $fail -eq 0 ]; then
    t0=$SECONDS
    cmd_say "$tid" "Run exactly this command and nothing else: $NOTIFY_BIN --thread $tid --status done \"t3ctl selftest callback\"" >/dev/null
    local deadline=$((SECONDS + 150))
    while :; do
      w=$(cmd_watch "$tid" --timeout 20); reason=$(jq -r .reason <<<"$w")
      [ "$reason" = settled ] && break
      # pending-approval here is expected: the approver takes up to one
      # 15 s cycle. Anything else that is not "still running" is a failure.
      case $reason in pending-approval|timeout) ;; *) break;; esac
      [ $SECONDS -ge $deadline ] && break
    done
    if [ "$reason" = settled ] && [ "$(jq -r '.lastError // ""' <<<"$w")" = "" ]; then
      local acc; acc=$(cmd_approvals "$tid" | jq -s '[.[] | select(.payload.decision == "accept")] | length')
      if [ "$acc" -ge 1 ]; then cb_s=$((SECONDS - t0)); else fail=1; echo "selftest: callback settled but no accepted approval found (approver not running?)" >&2; fi
    else
      fail=1; echo "selftest: callback leg failed ($reason): $w" >&2
    fi
  fi

  ( simple_thread_cmd rm "$tid" >/dev/null ) || echo "selftest: could not delete probe thread $tid" >&2
  jq -cn --arg project "$project" --arg tid "$tid" --arg pong "$pong_s" --arg cb "$cb_s" --argjson ok "$([ $fail -eq 0 ] && echo true || echo false)" \
    '{ok:$ok, project:$project, threadId:$tid,
      pong: (if $pong == "" then "FAILED" else ($pong + "s") end),
      callback: (if $cb == "" then "FAILED" else ($cb + "s (approved unattended)") end),
      deleted:true}'
  return $fail
}

case ${1:---help} in
  projects)   shift; cmd_projects "$@";;
  models)     shift; cmd_models "$@";;
  list)       shift; cmd_list "$@";;
  new)        shift; cmd_new "$@";;
  say)        shift; cmd_say "$@";;
  show)       shift; cmd_show "$@";;
  last)       shift; cmd_last "$@";;
  answer)     shift; cmd_answer "$@";;
  search)     shift; cmd_search "$@";;
  watch)      shift; cmd_watch "$@";;
  approvals)  shift; cmd_approvals "$@";;
  approve)    shift; cmd_approve "$@";;
  approve-callbacks) shift; cmd_approve_callbacks "$@";;
  token)      shift; cmd_token "$@";;
  project)    shift; cmd_project "$@";;
  selftest)   shift; cmd_selftest "$@";;
  contract-check) shift; cmd_contract_check "$@";;
  interrupt|stop|rm|settle|unsettle) c=$1; shift; simple_thread_cmd "$c" "$@";;
  -h|--help|help) usage;;
  *) die "unknown command '$1' (t3ctl --help)";;
esac
