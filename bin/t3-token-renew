#!/usr/bin/env bash
# t3-token-renew — mint/rotate the two t3 credentials t3ctl uses.
#
# Why a rotation unit: t3 sessions ALWAYS expire — there is no non-expiring
# token — and a 401 from t3ctl would silently strand the agent's t3 control.
# Weekly rotation of 30d-TTL tokens means several missed runs are survivable.
#
# The credentials (t3ctl.conf.example; both least-privilege):
#   T3CTL_MCP_TOKEN_FILE  an `mcp-client` session for T3's MCP endpoint, the
#        path t3ctl uses for most commands: orchestration:read + operate (and,
#        at a full-access ceiling, the settings:write + source-control:write T3
#        attaches to it — only /mcp accepts this subject). Minted through T3's
#        OAuth approval with a one-time pairing code, because only that grants
#        a runtime-mode ceiling (T3CTL_MCP_ACCESS); a CLI-issued mcp-client
#        session is capped at approval-required.
#   T3CTL_TOKEN_FILE      an ordinary session with T3CTL_TOKEN_SCOPES
#        (orchestration:read + operate) for t3ctl's legacy calls (approvals,
#        the callback approver, stop, rm, list --all, mode changes).
# Each is minted as the user t3 runs as (its auth state lives in that user's
# ~/.t3/userdata), probed on its own path, swapped in root-only (the agent's
# shell runs as root; nothing else on the box should read them), and only
# then is the predecessor session revoked.
#
# Failure alerting: `hermes send` to the owner, because the failure mode is
# "t3 control quietly dies in up to 30 days".
set -uo pipefail

T3CTL_CONF=${T3CTL_CONF:-/etc/t3ctl.conf}
# shellcheck disable=SC1090
[ -r "$T3CTL_CONF" ] && . "$T3CTL_CONF"

TOKEN_FILE=${T3CTL_TOKEN_FILE:-/etc/t3ctl/token}
SESSION_FILE=${T3CTL_SESSION_FILE:-/etc/t3ctl/session-id}
TOKEN_SCOPES=${T3CTL_TOKEN_SCOPES:-orchestration:read orchestration:operate}
MCP_TOKEN_FILE=${T3CTL_MCP_TOKEN_FILE:-$TOKEN_FILE.mcp}
MCP_SESSION_FILE=${T3CTL_MCP_SESSION_FILE:-$SESSION_FILE.mcp}
ALLOW_FULL=${T3CTL_ALLOW_FULL_ACCESS:-1}
if [ "$ALLOW_FULL" = 1 ]; then MCP_ACCESS=${T3CTL_MCP_ACCESS:-full-access}; else MCP_ACCESS=${T3CTL_MCP_ACCESS:-auto}; fi
[ "$MCP_ACCESS" != full-access ] || [ "$ALLOW_FULL" = 1 ] || MCP_ACCESS=auto
T3_USER=${T3CTL_T3_USER:-dev}
T3_WORKDIR=${T3CTL_T3_WORKDIR:-/data/workspace}
T3_VERSION_FILE=${T3CTL_T3_VERSION_FILE:-/etc/default/t3}
TTL=${T3CTL_TOKEN_TTL:-30d}
LABEL=${T3CTL_TOKEN_LABEL:-t3ctl}
MCP_LABEL=${T3CTL_MCP_TOKEN_LABEL:-$LABEL-mcp}
BASE=${T3CTL_URL:-http://127.0.0.1:3773}
HERMES=${T3CTL_HERMES:-/opt/hermes-venv/bin/hermes}
HERMES_HOME=${T3CTL_HERMES_HOME:-/data/repo/home}
TARGET=${T3CTL_ALERT_TARGET:-}
FALLBACK=${T3CTL_ALERT_FALLBACK:-}
T3MCP=${T3CTL_MCP_BIN:-$(dirname "${BASH_SOURCE[0]}")/t3-mcp}

fail() {
  echo "t3-token-renew: $*" >&2
  body="⚠️ t3 token renewal failed on $(hostname): $*
t3ctl will start 401ing when the current token expires. Fix: systemctl start t3-token-renew (see journalctl -u t3-token-renew)."
  if [ -n "$TARGET" ] && [ -x "$HERMES" ]; then
    HERMES_HOME="$HERMES_HOME" "$HERMES" send --to "$TARGET" -q "$body" \
      || { [ -n "$FALLBACK" ] && HERMES_HOME="$HERMES_HOME" "$HERMES" send --to "$FALLBACK" -q "$body"; } || true
  fi
  exit 1
}

VER=$(sed -n 's/^T3_VERSION=//p' "$T3_VERSION_FILE")
[ -n "$VER" ] || fail "no T3_VERSION in $T3_VERSION_FILE"

# The t3 CLI as the t3 user. T3CTL_T3_CLI replaces it (tests; a box with t3 on PATH).
as_t3_user() {
  if [ -n "${T3CTL_T3_CLI:-}" ]; then "$T3CTL_T3_CLI" "$@" </dev/null; return; fi
  runuser -u "$T3_USER" -- bash -lc "cd '$T3_WORKDIR' && npx -y t3@$VER $*" </dev/null
}
scope_flags() { local s; for s in $1; do printf -- '--scope %s ' "$s"; done; }

install_token() { # $1 token, $2 session id, $3 token file, $4 session file, $5 what
  local old_sid
  old_sid=$(cat "$4" 2>/dev/null || true)
  ( umask 077
    mkdir -p "$(dirname "$3")" "$(dirname "$4")"
    printf '%s\n' "$1" > "$3.tmp" && mv "$3.tmp" "$3" && printf '%s\n' "$2" > "$4.tmp" && mv "$4.tmp" "$4" ) \
    || fail "could not install the new $5 token at $3"
  # Revoke the predecessor only after the new token is installed. Best-effort:
  # an unrevoked old session just expires on its own TTL.
  if [ -n "$old_sid" ] && [ "$old_sid" != "$2" ]; then
    as_t3_user auth session revoke "$old_sid" >/dev/null 2>&1 \
      || echo "t3-token-renew: warning: could not revoke old $5 session $old_sid (it will expire by TTL)" >&2
  fi
}

exec 9>"$TOKEN_FILE.lock" || fail "cannot open $TOKEN_FILE.lock"
flock -w 120 9 || fail "another t3-token-renew holds $TOKEN_FILE.lock"

# ---- 1. legacy-path session: ordinary subject, T3CTL_TOKEN_SCOPES only -------
# shellcheck disable=SC2046
out=$(as_t3_user auth session issue $(scope_flags "$TOKEN_SCOPES") --ttl "$TTL" --label "$LABEL" --json 2>&1) \
  || fail "session issue errored: $(tail -c 300 <<<"$out")"
tok=$(jq -r '.token // empty' <<<"$out" 2>/dev/null)
sid=$(jq -r '.sessionId // empty' <<<"$out" 2>/dev/null)
[ -n "$tok" ] && [ -n "$sid" ] || fail "could not parse token/sessionId from issue output"
# Probe the new token before swapping it in — never replace a working token
# with a broken one. (/api/orchestration/snapshot is gone in V2 and its path
# falls through to the web app with a 200, so it proved nothing.)
curl -sSf -m 30 -H "Authorization: Bearer $tok" -H "x-t3-orchestration-protocol: 2" \
  "$BASE/api/orchestration/shell" -o /dev/null \
  || fail "new legacy token failed its shell probe (t3 down, or API changed after a T3_VERSION bump)"
install_token "$tok" "$sid" "$TOKEN_FILE" "$SESSION_FILE" legacy

# ---- 2. MCP session: OAuth sign-in approved by a one-time pairing code -------
# shellcheck disable=SC2046
pair=$(as_t3_user auth pairing create $(scope_flags "$("$T3MCP" scopes "$MCP_ACCESS")") --ttl 10m --label "$MCP_LABEL-pairing" --json 2>&1) \
  || fail "pairing create errored: $(tail -c 300 <<<"$pair" | grep -v credential)"
code=$(jq -r '.credential // empty' <<<"$pair" 2>/dev/null)
pair_id=$(jq -r '.id // empty' <<<"$pair" 2>/dev/null)
[ -n "$code" ] || fail "could not parse the pairing code from 'auth pairing create' output"
name="$MCP_LABEL $(date -u +%Y%m%dT%H%M%SZ)-$(uuidgen | cut -c1-8)"   # unique: finds the session id below
res=$(printf '%s' "$code" | T3CTL_URL="$BASE" "$T3MCP" oauth-mint --access "$MCP_ACCESS" --client-name "$name" 2>&1) || {
  [ -z "$pair_id" ] || as_t3_user auth pairing revoke "$pair_id" >/dev/null 2>&1
  fail "MCP sign-in failed: $(tail -c 300 <<<"$res")"; }
mtok=$(jq -r '.token // empty' <<<"$res" 2>/dev/null)
[ -n "$mtok" ] || fail "MCP sign-in returned no token"
T3CTL_URL="$BASE" T3CTL_MCP_BEARER="$mtok" "$T3MCP" probe --t3ctl >/dev/null \
  || fail "new MCP token failed its probe (initialize + tools/list for every tool t3ctl calls)"
msid=$(as_t3_user auth session list --json 2>/dev/null | jq -r --arg n "$name" \
  '[.[] | select(.client.label == $n) | .sessionId] | if length == 1 then .[0] else empty end' 2>/dev/null)
[ -n "$msid" ] || echo "t3-token-renew: warning: could not find the new MCP session's id; it cannot be revoked at the next rotation and expires by its 30 d TTL" >&2
install_token "$mtok" "$msid" "$MCP_TOKEN_FILE" "$MCP_SESSION_FILE" MCP

echo "t3-token-renew: rotated (legacy session $sid, ttl $TTL, scopes $TOKEN_SCOPES; MCP session ${msid:-?}, access $MCP_ACCESS, ttl 30d)"
